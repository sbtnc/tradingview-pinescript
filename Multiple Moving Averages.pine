// Version 3.0

// @version=6
indicator(title = "Multiple Moving Averages", shorttitle = "MAs", overlay = true)


//--------------------------------------------------------------------
//#region                      Constants
//--------------------------------------------------------------------

int     DEFAULT_LINEWIDTH   = 1
color   DEFAULT_COLOR1      = color.new(#c9daf8, 0)
color   DEFAULT_COLOR2      = color.new(#a4c2f4, 4)
color   DEFAULT_COLOR3      = color.new(#6d9eeb, 8)
color   DEFAULT_COLOR4      = color.new(#3c78d8, 12)
color   DEFAULT_COLOR5      = color.new(#0b5394, 16)
string  LINE_EXTEND         = extend.none
string  LINE_STYLE          = line.style_dashed
int     LINE_WIDTH          = 1

//#endregion



//--------------------------------------------------------------------
//#region                         Types 
//--------------------------------------------------------------------

enum maType
    sma     = "SMA" 
    ema     = "EMA"
    smma    = "SMMA (RMA)"
    wma     = "WMA"
    vwma    = "VWMA"

//#endregion



//--------------------------------------------------------------------
//#region                        Inputs
//--------------------------------------------------------------------

// Groups

string g1 = "#1"
string g2 = "#2"
string g3 = "#3"
string g4 = "#4"
string g5 = "#5"
string g6 = "Preferences"

// Tooltips

string tt_timeframe = "You can display a Moving Average from a higher timeframe. " +
                     "Note: It will be automatically hidden when switching the chart to a timeframe higher than its timeframe."

// Inputs

maType  typeInput1              = input.enum        (defval = maType.ema,   title = "Type",                         group = g1)
int     lengthInput1            = input.int         (defval = 9,            title = "Length",                       group = g1, minval = 1)
float   sourceInput1            = input.source      (defval = close,        title = "Source",                       group = g1)
int     offsetInput1            = input.int         (defval = 0,            title = "Offset",                       group = g1)
string  timeframeInput1         = input.timeframe   (defval = "",           title = "Timeframe",                    group = g1, tooltip = tt_timeframe)

maType  typeInput2              = input.enum        (defval = maType.ema,   title = "Type",                         group = g2)
int     lengthInput2            = input.int         (defval = 20,           title = "Length",                       group = g2, minval = 1)
float   sourceInput2            = input.source      (defval = close,        title = "Source",                       group = g2)
int     offsetInput2            = input.int         (defval = 0,            title = "Offset",                       group = g2)
string  timeframeInput2         = input.timeframe   (defval = "",           title = "Timeframe",                    group = g2, tooltip = tt_timeframe)

maType  typeInput3              = input.enum        (defval = maType.ema,   title = "Type",                         group = g3)
int     lengthInput3            = input.int         (defval = 50,           title = "Length",                       group = g3, minval = 1)
float   sourceInput3            = input.source      (defval = close,        title = "Source",                       group = g3)
int     offsetInput3            = input.int         (defval = 0,            title = "Offset",                       group = g3)
string  timeframeInput3         = input.timeframe   (defval = "",           title = "Timeframe",                    group = g3, tooltip = tt_timeframe)

maType  typeInput4              = input.enum        (defval = maType.ema,   title = "Type",                         group = g4)
int     lengthInput4            = input.int         (defval = 100,          title = "Length",                       group = g4, minval = 1)
float   sourceInput4            = input.source      (defval = close,        title = "Source",                       group = g4)
int     offsetInput4            = input.int         (defval = 0,            title = "Offset",                       group = g4)
string  timeframeInput4         = input.timeframe   (defval = "",           title = "Timeframe",                    group = g4, tooltip = tt_timeframe)

maType  typeInput5              = input.enum        (defval = maType.ema,   title = "Type",                         group = g5)
int     lengthInput5            = input.int         (defval = 200,          title = "Length",                       group = g5, minval = 1)
float   sourceInput5            = input.source      (defval = close,        title = "Source",                       group = g5)
int     offsetInput5            = input.int         (defval = 0,            title = "Offset",                       group = g5)
string  timeframeInput5         = input.timeframe   (defval = "",           title = "Timeframe",                    group = g5, tooltip = tt_timeframe)

bool    enableGapsInput         = input.bool        (defval = true,         title = "Wait for timeframe closes",    group = g6)
bool    showLevelsInput         = input.bool        (defval = true,         title = "Horizontal Levels",            group = g6) 
int     levelOffsetStartInput   = input.int         (defval = 0,            title = "Offset 1",                     group = g6, minval = 0)
int     levelOffsetEndInput     = input.int         (defval = 50,           title = "Offset 2",                     group = g6, minval = 1)

//#endregion


//--------------------------------------------------------------------
//#region                       Functions 
//--------------------------------------------------------------------

// @function Get the Moving Average (MA)
// @returns float
getMa(maType _type, float _source, _length) =>
    switch _type
        maType.sma  => ta.sma(_source, _length)
        maType.ema  => ta.ema(_source, _length)
        maType.smma => ta.rma(_source, _length)
        maType.wma  => ta.wma(_source, _length)
        maType.vwma => ta.vwma(_source, _length)


// @function Check if a timeframe is higher or equal than the chart's one
// @returns bool
canDisplay(string tf) =>
    timeframe.in_seconds(tf) >= timeframe.in_seconds()


draw(float y, color c) =>
    // draw only when the MA price is not `na` (e.g. when MA period exceed the number of bars)
    if not na(y)
        int _x1 = bar_index + levelOffsetStartInput
        int _x2 = _x1 + levelOffsetEndInput

        var _line = line.new(
             x1     = _x1,
             y1     = y, 
             x2     = _x2, 
             y2     = y, 
             xloc   = xloc.bar_index, 
             extend = LINE_EXTEND, 
             color  = c, 
             style  = LINE_STYLE, 
             width  = LINE_WIDTH
             )
        
        if barstate.islast
            line.set_xy1(_line, _x1, y)
            line.set_xy2(_line, _x2, y)

//#endregion


//--------------------------------------------------------------------
//#region                         Logic
//--------------------------------------------------------------------

var gaps = enableGapsInput ? barmerge.gaps_on : barmerge.gaps_off

float ma1 = request.security(symbol = "", timeframe = timeframeInput1, expression = getMa(typeInput1, sourceInput1, lengthInput1), gaps = gaps)
float ma2 = request.security(symbol = "", timeframe = timeframeInput2, expression = getMa(typeInput2, sourceInput2, lengthInput2), gaps = gaps)
float ma3 = request.security(symbol = "", timeframe = timeframeInput3, expression = getMa(typeInput3, sourceInput3, lengthInput3), gaps = gaps)
float ma4 = request.security(symbol = "", timeframe = timeframeInput4, expression = getMa(typeInput4, sourceInput4, lengthInput4), gaps = gaps)
float ma5 = request.security(symbol = "", timeframe = timeframeInput5, expression = getMa(typeInput5, sourceInput5, lengthInput5), gaps = gaps)

//#endregion


//--------------------------------------------------------------------
//#region                   Plotting & styling
//--------------------------------------------------------------------

plot(series = canDisplay(timeframeInput1) ? ma1 : na, title = "#1", color = DEFAULT_COLOR1, linewidth = DEFAULT_LINEWIDTH, offset = offsetInput1)
plot(series = canDisplay(timeframeInput2) ? ma2 : na, title = "#2", color = DEFAULT_COLOR2, linewidth = DEFAULT_LINEWIDTH, offset = offsetInput2)
plot(series = canDisplay(timeframeInput3) ? ma3 : na, title = "#3", color = DEFAULT_COLOR3, linewidth = DEFAULT_LINEWIDTH, offset = offsetInput3)
plot(series = canDisplay(timeframeInput4) ? ma4 : na, title = "#4", color = DEFAULT_COLOR4, linewidth = DEFAULT_LINEWIDTH, offset = offsetInput4)
plot(series = canDisplay(timeframeInput5) ? ma5 : na, title = "#5", color = DEFAULT_COLOR5, linewidth = DEFAULT_LINEWIDTH, offset = offsetInput5)

if showLevelsInput
    draw(ma1, DEFAULT_COLOR1)
    draw(ma2, DEFAULT_COLOR2)
    draw(ma3, DEFAULT_COLOR3)
    draw(ma4, DEFAULT_COLOR4)
    draw(ma5, DEFAULT_COLOR5)

//#endregion