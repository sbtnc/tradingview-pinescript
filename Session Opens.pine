//--------------------------------------------------------------------
//#region                        Inputs
//--------------------------------------------------------------------

string      group1              = "Opens"

bool        enableLevel1        = input.bool    (true,          title = "", inline = "Session #1", group = group1)
string      nameInput1          = input.string  ("NY",          title = "", inline = "Session #1", group = group1)
string      sessionInput1       = input.session ("0800-1200",   title = "", inline = "Session #1", group = group1)
Timezones   timezoneInput1      = input.enum    (Timezones.nyc, title = "", inline = "Session #1", group = group1)
bool        enableLevel2        = input.bool    (true,          title = "", inline = "Session #2", group = group1)
string      nameInput2          = input.string  ("London",      title = "", inline = "Session #2", group = group1)
string      sessionInput2       = input.session ("0800-1200",   title = "", inline = "Session #2", group = group1)
Timezones   timezoneInput2      = input.enum    (Timezones.lon, title = "", inline = "Session #2", group = group1)
bool        enableLevel3        = input.bool    (true,          title = "", inline = "Session #3", group = group1)
string      nameInput3          = input.string  ("Asia",        title = "", inline = "Session #3", group = group1)
string      sessionInput3       = input.session ("0800-1200",   title = "", inline = "Session #3", group = group1)
Timezones   timezoneInput3      = input.enum    (Timezones.tyo, title = "", inline = "Session #3", group = group1)
bool        enableLevel4        = input.bool    (true,          title = "", inline = "Session #4", group = group1)
string      nameInput4          = input.string  ("Midnight",    title = "", inline = "Session #4", group = group1)
string      sessionInput4       = input.session ("0000-0100",   title = "", inline = "Session #4", group = group1)
Timezones   timezoneInput4      = input.enum    (Timezones.nyc, title = "", inline = "Session #4", group = group1)

string      group2              = "Style"
string      rightOffsetTooltip  = "Extend the current opens to the right of the last bar."

color       openColorInput1     = input.color   (COLOR_1,           title = "", inline = "Session #1", group = group2)
color       openColorInput2     = input.color   (COLOR_2,           title = "", inline = "Session #2", group = group2)
color       openColorInput3     = input.color   (COLOR_3,           title = "", inline = "Session #3", group = group2)
color       openColorInput4     = input.color   (COLOR_4,           title = "", inline = "Session #4", group = group2)
int         widthInput1         = input.int     (LINE_WIDTH,        title = "", inline = "Session #1", group = group2, minval = 1, maxval = 20, display = display.none)
int         widthInput2         = input.int     (LINE_WIDTH,        title = "", inline = "Session #2", group = group2, minval = 1, maxval = 20, display = display.none)
int         widthInput3         = input.int     (LINE_WIDTH,        title = "", inline = "Session #3", group = group2, minval = 1, maxval = 20, display = display.none)
int         widthInput4         = input.int     (LINE_WIDTH,        title = "", inline = "Session #4", group = group2, minval = 1, maxval = 20, display = display.none)
LineStyles  styleInput1         = input.enum    (LineStyles.solid,  title = "", inline = "Session #1", group = group2, display = display.none)
LineStyles  styleInput2         = input.enum    (LineStyles.solid,  title = "", inline = "Session #2", group = group2, display = display.none)
LineStyles  styleInput3         = input.enum    (LineStyles.solid,  title = "", inline = "Session #3", group = group2, display = display.none)
LineStyles  styleInput4         = input.enum    (LineStyles.dashed, title = "", inline = "Session #4", group = group2, display = display.none)
int         rightOffsetInput    = input.int     (20,                title = "Offset", group = group2, tooltip = rightOffsetTooltip, minval = 1, maxval = 500, display = display.none)

//#endregion


//--------------------------------------------------------------------
//#region                   Functions & methods
//--------------------------------------------------------------------

// @function Produce the line `style` parameter from the given user input.
// @returns  string
method param(LineStyles input) =>
    switch input
        LineStyles.solid  => line.style_solid
        LineStyles.dotted => line.style_dotted
        LineStyles.dashed => line.style_dashed


// @function Calculate the bar index of the second point of the level.
// @returns  (int) The bar index. 
getEndingBarIndex(int padding = 0) =>
    bar_index + rightOffsetInput + padding * OFFSET_PADDING


// @function Calculate the padding of the second point of the level for not overlapping the other proximate levels.
// @returns  int
method padding(array<Open> this, int idx, float proximityThreshold) =>
    int _padding = 0

    if barstate.islast
        if this.size() >= 2 and idx > 0
            for i = idx -1 to 0
                if this.get(i).display and math.abs(this.get(i).price - this.get(idx).price) <= proximityThreshold
                    _padding += 1

    _padding


// @function Create and update the open level. The open is composed of a line and a label.
// @returns  void
method draw(Open this, bool change, int lookback, int padding) =>
    // @variable The reference of the current open line.
    var line _line = na

    // @variable The reference of the current open label.
    var label _label = label.new(
         x                = na,
         y                = na,
         text             = this.name,
         color            = LABEL_COLOR,
         style            = LABEL_STYLE,
         size             = LABEL_SIZE,
         textcolor        = this.color,
         text_font_family = LABEL_FONT_FAMILY
         )

    // @variable The collection of historical open lines.
    var array<line> _lineArray = array.new_line()

    // Finalize the last open and create the new open.
    if change
        // Anchor the ending bar index of the last open line.
        _line.set_x2(bar_index -1)

        // Create and store the new open line.
        _line := line.new(
             x1    = bar_index,
             x2    = na,
             y1    = this.price,
             y2    = this.price,
             color = this.color,
             style = this.style,
             width = this.width
             )
        array.push(_lineArray, _line)

        // Maintain the number of historical open lines.
        if _lineArray.size() > lookback
            _lineArray.shift().delete()

        // Update the current open label.
        _label.set_y(this.price)
        _label.set_tooltip(str.tostring(this.price, format.mintick))

    // Update the ending bar index of the current open level.
    if barstate.islast
        int _x = getEndingBarIndex(padding)

        _line.set_x2(_x)
        _label.set_x(_x)


// @function Update the `Open` UDT price.
// @returns  (bool) True on update.
method update(Open this, string timeframe, string session, string timezone) =>
    // @variable The time point in the session.  
    int _time = time("D", session, timezone = timezone)

    // @variable True if the session starts.
    bool _sessionChange = ta.change(nz(_time)) > 0

    // Get the session change and opening price within the chart bar.
    [_sessionChangeIntrabarArray, _openIntrabarArray] = request.security_lower_tf("", timeframe, [_sessionChange, open])

    // @variable The lower-timeframe bar index of the last session change occurence.
    int changeIndex = _sessionChangeIntrabarArray.lastindexof(true)

    // @variable True if the session change was found.
    bool hasChanged = changeIndex != -1

    // Update the open's price.
    this.price := hasChanged ? _openIntrabarArray.get(changeIndex) : this.price

    hasChanged

//#endregion


//--------------------------------------------------------------------
//#region                 Variables declarations
//--------------------------------------------------------------------

// @variable The `Open` UDTs. 
var Open open1 = Open.new(
     name    = nameInput1,
     style   = styleInput1.param(),
     color   = openColorInput1,
     width   = widthInput1,
     display = enableLevel1
     )

var Open open2 = Open.new(
     name    = nameInput2,
     style   = styleInput2.param(),
     color   = openColorInput2,
     width   = widthInput2,
     display = enableLevel2
     )

var Open open3 = Open.new(
     name    = nameInput3,
     style   = styleInput3.param(),
     color   = openColorInput3,
     width   = widthInput3,
     display = enableLevel3
     )

var Open open4 = Open.new(
     name    = nameInput4,
     style   = styleInput4.param(),
     color   = openColorInput4,
     width   = widthInput4,
     display = enableLevel4
     )

// @variable The array of current opens. 
var array<Open> openArray = array.from(open1, open2, open3, open4)

// @variable The lower timeframe precision on a higher chart context, otherwise the chart context timeframe.
string timeframe = timeframe.in_seconds() > timeframe.in_seconds(LOWER_TIMEFRAME) ? LOWER_TIMEFRAME : ""

// @variable The maximum distance to determine if two levels are too proximate.
float proximityPaddingThreshold = ta.atr(10) /2

//#endregion


//--------------------------------------------------------------------
//#region                         Logic
//--------------------------------------------------------------------

bool change1 = if open1.display
    open1.update(timeframe, sessionInput1, str.tostring(timezoneInput1))  

bool change2 = if open2.display
    open2.update(timeframe, sessionInput2, str.tostring(timezoneInput2))  

bool change3 = if open3.display
    open3.update(timeframe, sessionInput3, str.tostring(timezoneInput3)) 

bool change4 = if open4.display
    open4.update(timeframe, sessionInput4, str.tostring(timezoneInput4)) 

//#endregion


//--------------------------------------------------------------------
//#region                        Visuals
//--------------------------------------------------------------------

//#region - Draw the open levels.

if open1.display
    open1.draw(
         change1,
         10,
         0
         )

if open2.display
    open2.draw(
         change2,
         10,
         openArray.padding(1, proximityPaddingThreshold)
         )

if open3.display
    open3.draw(
         change3,
         10,
         openArray.padding(2, proximityPaddingThreshold)
         )

if open4.display
    open4.draw(
         change4,
         10,
         openArray.padding(3, proximityPaddingThreshold)
         )

//#endregion


//#region - Plot the open prices on the `status line`, `price scale`, `data window` as well for providing alert conditions.

displayControls = display.status_line + display.price_scale + display.data_window

plot(
     series   = open1.price,
     title    = "#1",
     color    = open1.color,
     editable = false,
     display  = enableLevel1 ? displayControls : display.none
     )

plot(
     series   = open2.price,
     title    = "#2",
     color    = open2.color,
     editable = false,
     display  = enableLevel2 ? displayControls : display.none
     )

plot(
     series   = open3.price,
     title    = "#3",
     color    = open3.color,
     editable = false,
     display  = enableLevel3 ? displayControls : display.none
     )

plot(
     series   = open4.price,
     title    = "#4",
     color    = open4.color,
     editable = false,
     display  = enableLevel4 ? displayControls : display.none
     )

//#endregion

//#endregion


