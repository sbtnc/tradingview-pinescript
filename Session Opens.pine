indicator("Intraday Opens", overlay = true, max_lines_count = 500, dynamic_requests = true)


//--------------------------------------------------------------------
//#region                      Constants
//--------------------------------------------------------------------

color   COLOR_1             = #1a2c54
color   COLOR_2             = #8351a8
color   COLOR_3             = #4d7b93
color   COLOR_4             = #b45dbb
color   LABEL_COLOR         = color(na)
string  LABEL_SIZE          = size.small
string  LABEL_STYLE         = label.style_label_left
string  LABEL_FONT_FAMILY   = font.family_default
int     LINE_WIDTH          = 1
int     OFFSET_PADDING      = 4
string  LOWER_TIMEFRAME     = "15"

//#endregion


//--------------------------------------------------------------------
//#region                         Types 
//--------------------------------------------------------------------

// @type Contains the open's data.
type Open 
    float   price 
    string  name
    color   color
    string  style
    int     width
    bool    display


